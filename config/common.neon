includes:
	- console.neon

extensions:
	cms: App\Core\DI\CmsExtension

cms:
	siteName: CMS Lite # placeholder, override in config/local.neon

application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping:
		*: App\Presentation\*\**Presenter

latte:
	strictTypes: true
	extensions:
		- Latte\Essential\TranslatorExtension

assets:
	mapping:
		default: assets

session:
	autoStart: false

database:
	dsn: 'mysql:host=%dbHost%;port=%dbPort%;dbname=%dbName%'
	user: %dbUser%
	password: %dbPassword%
