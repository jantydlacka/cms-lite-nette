includes:
	- console.neon

parameters:
	locale: cs

application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping:
		*: App\Presentation\*\**Presenter

latte:
	strictTypes: true

session:
	autoStart: false

database:
	dsn: 'mysql:host=%dbHost%;port=%dbPort%;dbname=%dbName%'
	user: %dbUser%
	password: %dbPassword%
