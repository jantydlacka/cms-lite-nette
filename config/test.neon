# Loaded after common.neon/services.neon by App\Bootstrap::bootForTests().
services:
	tracy.logger: Tests\FakeLogger
	# Strict even though debugMode is off: a typo'd key must fail CI.
	translator:
		arguments: [strict: true]
	# Debug mode is off, so Latte would never notice an edited template between direct test runs.
	latte.latteFactory:
		setup:
			- setAutoRefresh(true)
	# Per container, so each request logs as a first one and no warning outlives a test run.
	componentWarningGate:
		arguments: [storage: Nette\Caching\Storages\MemoryStorage()]
