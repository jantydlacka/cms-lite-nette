/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.gif
/docs/**/*.jpeg
/docs/**/*.webp
/docs/**/*.svg
/docs/**/*.mp4
/docs/**/*.webm
/docs/**/*.pdf
!/docs/images/*.png
