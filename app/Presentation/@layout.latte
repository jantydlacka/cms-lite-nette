<!DOCTYPE html>
<html lang="{$locale}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{block title}{$siteName}{/block}</title>
	{block head}{/block}
	<script>
		(function () {
			var theme = null;
			try {
				theme = localStorage.getItem('cms-theme');
			} catch (e) {}
			if (theme !== 'light' && theme !== 'dark') {
				theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			}
			document.documentElement.setAttribute('data-theme', theme);
		})();
	</script>
	{asset 'vendor/pico.min.css'}
	{asset 'front.css'}
</head>
<body>
	<header class="site-header container">
		<a href="{plink :Front:Home:default}" class="site-name" data-testid="site-name">{$siteName}</a>
		<button type="button" class="theme-toggle secondary outline" data-testid="theme-toggle" aria-label="{_front.theme.dark}" title="{_front.theme.dark}">{_front.theme.label}</button>
	</header>
	{* Only front presenters set $menu: error pages must render without the database. *}
	<nav n:ifset="$menu" class="site-menu container" aria-label="{_front.menu.label}" data-testid="menu">
		{include menuItems, items: $menu, currentPageId: $currentPageId, homepageId: $homepageId}
	</nav>
	<main class="container">
		{include content}
	</main>
	<footer class="site-footer container">
		<small>{$siteName}</small>
	</footer>
	{asset 'front.js'}
</body>
</html>

{define menuItems, array $items, ?int $currentPageId, ?int $homepageId}
	<ul n:if="$items">
		<li n:foreach="$items as $item">
			<a href="{if $item->pageId === $homepageId}{plink :Front:Home:default}{else}{plink :Front:Page:default, path: $item->path}{/if}" aria-current="{$item->pageId === $currentPageId ? 'page'}" data-testid="menu-item">{$item->title}</a>
			{include menuItems, items: $item->children, currentPageId: $currentPageId, homepageId: $homepageId}
		</li>
	</ul>
{/define}
