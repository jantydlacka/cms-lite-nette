{
	"name": "jantydlacka/cms-lite-nette",
	"description": "A small, well-structured CMS built on Nette.",
	"type": "project",
	"license": "MIT",
	"minimum-stability": "stable",
	"require": {
		"php": ">=8.3",
		"contributte/console": "^0.11",
		"latte/latte": "^3.1",
		"nette/application": "^3.3",
		"nette/assets": "^1.0",
		"nette/bootstrap": "^3.3",
		"nette/database": "^3.2",
		"nette/forms": "^3.3",
		"nette/schema": "^1.4",
		"nette/utils": "^4.1",
		"nextras/migrations": "^3.5",
		"psr/clock": "^1.0",
		"tracy/tracy": "^2.12"
	},
	"require-dev": {
		"nette/tester": "^2.6",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpat/phpat": "^0.12",
		"phpstan/phpstan": "^2.3",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-nette": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.1",
		"roave/security-advisories": "dev-latest",
		"slevomat/coding-standard": "^8.31",
		"symplify/easy-coding-standard": "^13.3",
		"vimeo/psalm": "^6.20"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
